# Dependencies and build output
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
.vite/
*.tsbuildinfo

# Environment and local configuration
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/.cache/
frontend/.parcel-cache/
backend/.env
backend/.env.*
