{
  "model_name": "Bellandur P5 prototype hydraulic model",
  "canonical_study_area": "config/study_area.json",
  "p4_nodes": "data/drainage/processed/drainage_nodes.geojson",
  "p4_links": "data/drainage/processed/drainage_links.geojson",
  "p4_component_validation": "data/drainage/validation/p4_validation.json",
  "rainfall_fixture": "data/swmm/tests/synthetic_storm.json",
  "public_crs": "EPSG:4326",
  "working_crs": "EPSG:32643",
  "observed_source_backed": {
    "ground_elevation": "P4 DEM-sampled ground_elevation_m",
    "link_length": "P4 metric geometry length_m",
    "node_coordinates": "P4 drainage_nodes.geojson",
    "link_geometry_and_provenance": "P4 drainage_links.geojson"
  },
  "model_assumptions": {
    "source": "model_assumption",
    "rationale": "P4 does not provide surveyed underground hydraulic attributes. These values make a small executable engineering prototype and are not BBMP measurements.",
    "invert_offset_below_ground_m": 1.0,
    "conduit_shape": "CIRCULAR",
    "conduit_diameter_m": 1.0,
    "conduit_roughness_manning_n": 0.013,
    "conduit_inlet_offset_m": 0.0,
    "conduit_outlet_offset_m": 0.0,
    "junction_max_depth_m": 2.0,
    "junction_initial_depth_m": 0.0,
    "junction_surcharge_depth_m": 0.5,
    "junction_ponded_area_m2": 100.0,
    "subcatchment_width_m": 100.0,
    "subcatchment_slope_percent": 1.0,
    "impervious_percent": 75.0,
    "impervious_roughness_n": 0.015,
    "pervious_roughness_n": 0.25,
    "impervious_storage_mm": 1.5,
    "pervious_storage_mm": 5.0,
    "percent_zero_impervious": 25.0,
    "infiltration_method": "HORTON",
    "horton_max_rate_mm_per_hour": 75.0,
    "horton_min_rate_mm_per_hour": 3.0,
    "horton_decay_per_hour": 4.0,
    "horton_dry_time_hours": 7.0,
    "outfall_type": "FREE",
    "outfall_flap_gate": "NO",
    "initial_link_flow_cms": 0.0,
    "closed_terminal_boundary_type": "closed_terminal_junction",
    "closed_terminal_boundary_source": "model_assumption",
    "closed_terminal_boundary_rule": "For valid P4 linked components without a verified outfall, retain the P4 terminal junctions as closed SWMM junction boundaries; do not add an outfall or connecting conduit.",
    "subcatchment_strategy": "full_canonical_bbox_grid_routed_to_nearest_p4_simulated_junction",
    "prototype_subcatchment_grid_cell_size_m": 250.0,
    "full_area_min_coverage_fraction": 0.995,
    "full_area_max_residual_fraction": 0.001
  },
  "routing": {
    "method": "DYNWAVE",
    "flow_units": "CMS",
    "hydraulic_timestep_seconds": 30,
    "report_timestep_seconds": 300,
    "allow_ponding": true
  },
  "outputs": {
    "model_directory": "data/swmm/models",
    "results_directory": "data/swmm/results",
    "metadata_directory": "data/swmm/metadata",
    "validation_directory": "data/swmm/validation"
  }
}
